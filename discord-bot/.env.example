# NexPath Discord Bot Environment Configuration

# Place your Discord Bot Token here (from https://discord.com/developers/applications)
DISCORD_TOKEN=your_bot_token_here

# NexPath Server ID
GUILD_ID=1550147193669816330

# Channel ID where GitHub Stars, Issues, and PRs will be posted
# e.g., your specified channel: 1550458099121262722
GITHUB_CHANNEL_ID=1550458099121262722

# GitHub Webhook Listener Port (runs on this local machine or server)
GITHUB_WEBHOOK_PORT=5000

# Optional: GitHub Webhook Secret (if configured on GitHub repo settings)
# GITHUB_WEBHOOK_SECRET=your_secret_here

# Auto-study server upon startup (true/false)
AUTO_STUDY=true
