{
  "name": "nexpath-cli",
  "version": "0.1.57",
  "description": "Behaviour guidance system for vibe coders using AI coding agents",
  "license": "Apache-2.0",
  "homepage": "https://github.com/hi0001234d/nexpath#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hi0001234d/nexpath.git"
  },
  "bugs": {
    "url": "https://github.com/hi0001234d/nexpath/issues"
  },
  "keywords": [
    "nexpath",
    "prompt-engineering",
    "prompt-enhancement",
    "vibe-coding",
    "ai-coding-assistant",
    "ai-developer-tools",
    "coding-agent",
    "claude-code",
    "cursor",
    "windsurf",
    "mcp",
    "ai-code-quality",
    "developer-productivity",
    "cli"
  ],
  "type": "module",
  "bin": {
    "nexpath": "dist/cli/index.js",
    "nexpath-serve": "dist/server/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "tsx scripts/check-build-gate.ts",
    "build": "tsc",
    "postbuild": "node -e \"['dist/cli/index.js','dist/server/index.js'].forEach(f => require('fs').chmodSync(f, 0o755))\"",
    "build:ext": "node scripts/build-ext.mjs",
    "package:ext": "node scripts/package-ext.mjs",
    "build:ui-harness": "esbuild src/ext-browser/ui/ui-mock-harness/index.ts --bundle --format=esm --external:../../../ext-browser/ui/ui.js --outfile=src/ext-browser/ui/ui-mock-harness/index.js",
    "dev:cli": "tsx src/cli/index.ts",
    "dev:server": "tsx src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:ext": "tsc --noEmit -p tsconfig.ext-browser.json",
    "pe:launch-recheck": "tsx scripts/pe-public-launch-recheck.ts",
    "pe:leak-guard": "tsx scripts/pe-leak-guard.ts",
    "pe:body-assertion": "tsx scripts/pe-body-assertion.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "@clack/prompts": "^0.9",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "commander": "^12",
    "cross-keychain": "^1.1.0",
    "dotenv": "^17.4.2",
    "natural": "^8.1.1",
    "openai": "^6.34.0",
    "sql.js": "^1",
    "tinyld": "^1",
    "webextension-polyfill": "^0.12.0",
    "zod": "^3"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.270",
    "@types/natural": "^5.1.5",
    "@types/node": "^20",
    "@types/sql.js": "^1",
    "@types/webextension-polyfill": "^0.12.5",
    "esbuild": "^0.24.0",
    "jsdom": "^25.0.0",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=18"
  }
}
